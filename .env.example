# Local backend defaults. Render sets DATABASE_PATH to its persistent disk.
DATABASE_PATH=data/rtoguard.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Standalone Merchant API security and rate limiting
ADMIN_TOKEN=your_secure_admin_token_here
RATE_LIMIT_PER_MIN=60

# Optional natural-language summaries; model scoring and local SHAP do not need this.
GEMINI_API_KEY=

# Optional BHASHINI multilingual translation; localized templates used if unset.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Optional Razorpay integration. Use Razorpay test-mode credentials for demos.
# Without these, checkout is explicitly simulated and no money is charged.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Vite frontend settings (copy frontend/.env.example to frontend/.env).
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEFAULT_DATA_MODE=LIVE_BACKEND

# ─── Shipment Tracking API Integration ────────────────────────────────────────
# Choose a provider: "aftership" | "shiprocket" | leave blank for simulated mock mode.
TRACKING_PROVIDER=

# AfterShip (recommended for Indian couriers — Free tier: 100 trackings/month)
# Sign up: https://accounts.aftership.com/register
# API docs: https://developers.aftership.com/reference/introduction
# Get your API key at: https://app.aftership.com/settings/api-keys
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=

# Shiprocket (Indian shipping aggregator — Free for registered sellers)
# Sign up: https://app.shiprocket.in/register
# API docs: https://apidocs.shiprocket.in/
# Use your Shiprocket account email and password (or app-specific credentials).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Generic webhook secret (used when a courier sends custom webhooks to /api/tracking/webhook)
# Set this to any strong random string, e.g.: openssl rand -hex 32
TRACKING_WEBHOOK_SECRET=

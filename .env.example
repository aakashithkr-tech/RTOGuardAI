# Local backend defaults. Render sets DATABASE_PATH to its persistent disk.
DATABASE_PATH=data/rtoguard.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Optional natural-language summaries; model scoring and local SHAP do not need this.
GEMINI_API_KEY=

# Optional BHASHINI multilingual translation; localized templates used if unset.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Optional Razorpay integration. Use Razorpay test-mode credentials for demos.
# Without these, checkout is explicitly simulated and no money is charged.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Vite frontend settings (copy frontend/.env.example to frontend/.env).
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEFAULT_DATA_MODE=LIVE_BACKEND
